<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fitCenter" />

    <com.hi.khoangcachxe.OverlayView
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:orientation="vertical"
        android:background="#99000000"
        android:padding="10dp">

        <TextView
            android:id="@+id/tvMain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-- m"
            android:textColor="#FFFFFF"
            android:textSize="44sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đang khởi động camera..."
            android:textColor="#DDDDDD"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:background="#99000000"
        android:padding="6dp"
        android:textColor="#AAAAAA"
        android:textSize="11sp"
        android:text="" />

    <LinearLayout
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:orientation="vertical"
        android:background="#99000000"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvWidth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:text="Bề ngang xe trước: 1.80 m" />

        <SeekBar
            android:id="@+id/sbWidth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="140"
            android:progress="40" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCar"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="38dp"
                android:textSize="10sp"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Xe con" />

            <Button
                android:id="@+id/btnSuv"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="38dp"
                android:textSize="10sp"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="SUV" />

            <Button
                android:id="@+id/btnTruck"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="38dp"
                android:textSize="10sp"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Tải" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCalib"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:text="Hiệu chỉnh: 1.00" />

        <SeekBar
            android:id="@+id/sbCalib"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="60"
            android:progress="30" />

        <Button
            android:id="@+id/btnCalib"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:textSize="10sp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Hiệu chỉnh tự động bằng GPS" />

        <TextView
            android:id="@+id/tvCalibInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFD400"
            android:textSize="11sp"
            android:text="" />
    </LinearLayout>
</FrameLayout>
